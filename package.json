{
  "name": "flatmeal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "smoke:m5": "tsx scripts/smoke-local-m5.ts",
    "smoke:m5:local": "tsx scripts/smoke-local-m5.ts",
    "smoke:m5:openai": "tsx scripts/smoke-live-openai.ts",
    "smoke:m5:sarvam": "tsx scripts/smoke-live-sarvam.ts",
    "smoke:m5:telegram": "tsx scripts/smoke-telegram-config.ts",
    "smoke:m5:telegram-voice": "tsx scripts/smoke-telegram-voice-stt.ts",
    "smoke:m6": "tsx scripts/smoke-local-m6.ts",
    "smoke:m7": "tsx scripts/verify-m7-fixtures.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openai/agents": "^0.8.5",
    "@supabase/supabase-js": "^2.86.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
